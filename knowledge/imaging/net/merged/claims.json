      }
    ],
    "provenance": "enriched"
  },
  {
    "claim_id": "ERC-imaging-net-6fc8edc4",
    "text": "For GIF images, `ImageInfo.FrameCount` reflects the number of frames when the file contains multiple frames; it is omitted if the frame count cannot be determined.",
    "kind": "feature",
    "page_role": "product",
    "confidence": 0.93,
    "claim_source": "llm_enriched",
    "evidence": [
      {
        "source_file": "tests/Aspose.Imaging.Foss.Tests/ImageProbeTests.cs",
        "snippet": "var info = ImageProbe.Probe(SampleImages.GifWithFrames(64, 48, frameCount: 5));\nAssert.Equal(5, info.FrameCount);"
      },
      {
        "source_file": "tests/Aspose.Imaging.Foss.Tests/ImageProbeTests.cs",
        "snippet": "var info = ImageProbe.Probe(SampleImages.GifWithoutFrames(64, 48));\nAssert.Null(info.FrameCount);"
      }
    ],
    "provenance": "enriched"
  },
  {
    "claim_id": "ERC-imaging-net-54eab75c",
    "text": "When a BMP header specifies a negative height, `ImageInfo.Height` returns the absolute magnitude, normalizing the value to a positive number.",
    "kind": "feature",
    "page_role": "product",
    "confidence": 0.92,
    "claim_source": "llm_enriched",
    "evidence": [
      {
        "source_file": "tests/Aspose.Imaging.Foss.Tests/ImageProbeTests.cs",
