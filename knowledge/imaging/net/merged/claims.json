    "claim_id": "ERC-imaging-net-a86f34f7",
    "text": "The library can parse DICOM headers, handling Implicit VR Little Endian and Explicit VR (Little/Big Endian) transfer syntaxes to extract rows, columns, and bits allocated.",
    "kind": "feature",
    "page_role": "product",
    "confidence": 0.9,
    "claim_source": "llm_enriched",
    "evidence": [
      {
        "source_file": "README.md",
        "snippet": "DICOM parsing covers Implicit VR Little Endian and Explicit VR Little/Big Endian transfer syntaxes (including the common compressed ones, whose non-pixel elements are Explicit VR Little Endian); it stops rather than guesses if it hits a sequence or encapsulated pixel data with an undefined length before finding Rows/Columns/BitsAllocated."
      }
    ],
    "provenance": "enriched"
