+def split_kb_slug_verb_noun(slug: str, platform: str) -> tuple[str, str]:
+    """Split a 'how-to-{verb}-{noun}[-{platform suffix}]' slug into (verb, noun).
+
+    Single implementation shared by _validate_kb_slugs() (below) and
+    content_eval.evaluators.topic_grounding._extract_topic_noun() -- see
+    _KB_REVERSE_VERB_VOCAB's docstring for why the vocabulary is built the
+    way it is. verb == "" when no known verb leads the slug (noun is then
+    the whole remainder, unchanged -- the pre-existing, tested fallback).
+    """
+    if not slug.startswith("how-to-"):
+        raise ValueError(f"not a how-to slug: {slug!r}")
+    inner = slug[len("how-to-"):]
+    suffix = KB_PLATFORM_SUFFIX.get(platform, platform)
+    if inner.endswith(f"-{suffix}"):
+        inner = inner[: -(len(suffix) + 1)]
+    for kv in _KB_REVERSE_VERB_VOCAB:
+        if inner.startswith(kv + "-") and len(inner) > len(kv) + 1:
+            return kv, inner[len(kv) + 1:]
+    return "", inner
+
