[
  {
    "unit_id": "u0001",
    "excerpt": "Aspose.3D FOSS for .NET is a free, open-source, MIT-licensed .NET library for reading, building,\nand exporting 3D scenes. It exposes an Aspose.3D-compatible scene-graph API — `Scene`, `Node`,\n`Mesh`, `Camera`, `Transform` — and supports common interchange formats such as OBJ, STL, glTF/GLB,\nFBX, COLLADA, 3MF, and PLY (import only), without requiring any native runtime, external SDK, or\nthird-party renderer.",
    "classification": "2_mechanism_explanation",
    "disposition": "merged_reframed",
    "target_section": "Intro",
    "verification": {
      "status": "verified_against_source",
      "evidence_type": "clone_cache_path",
      "evidence_ref": "src/main/Aspose.ThreeD/Aspose/ThreeD/FileFormat.cs"
    }
