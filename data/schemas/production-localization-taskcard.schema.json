{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Production Localization Taskcard",
  "type": "object",
  "required": [
    "task_id",
    "stable_semantic_key",
    "incident_id",
    "primary_layer",
    "task_type",
    "title",
    "objective",
    "current_state",
    "target_state",
    "risk",
    "required_skills",
    "required_commands",
    "status",
    "closeout_rules"
  ],
  "properties": {
    "task_id": {"type": "string"},
    "stable_semantic_key": {"type": "string"},
    "incident_id": {"type": "string"},
    "primary_layer": {"type": "string"},
    "task_type": {"type": "string"},
    "title": {"type": "string"},
    "objective": {"type": "string"},
    "current_state": {"type": "string"},
    "target_state": {"type": "string"},
    "risk": {"type": "string"},
    "affected_sites": {"type": "array"},
    "affected_families": {"type": "array"},
    "affected_platforms": {"type": "array"},
    "affected_locales": {"type": "array"},
    "affected_pages": {"type": "array"},
    "dependencies": {"type": "array"},
    "required_skills": {"type": "array", "items": {"type": "string"}},
    "required_commands": {"type": "array", "items": {"type": "string"}},
    "allowed_paths": {"type": "array"},
    "forbidden_paths": {"type": "array"},
    "implementation_steps": {"type": "array"},
    "automated_verification": {"type": "array"},
    "human_verification": {"type": "array"},
    "preview_requirements": {"type": "array"},
    "deployment_requirements": {"type": "array"},
    "rollback": {"type": "object"},
    "evidence_requirements": {"type": "array"},
    "status": {"type": "string"},
    "closeout_rules": {"type": "array"}
  },
  "additionalProperties": true
}
