{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Production Localization Incident Request",
  "type": "object",
  "required": [
    "incident_id",
    "incident_title",
    "detected_at",
    "reported_urls",
    "suspected_sites",
    "suspected_families",
    "suspected_platforms",
    "suspected_locales",
    "incident_types",
    "source_repository",
    "source_revision",
    "live_verification_required",
    "CDN_verification_required",
    "human_review_required",
    "containment_mode",
    "execution_mode",
    "allowed_paths",
    "forbidden_paths",
    "evidence_root",
    "rollback_required",
    "terminal_closeout_required"
  ],
  "properties": {
    "incident_id": {"type": "string", "minLength": 1},
    "incident_title": {"type": "string", "minLength": 1},
    "detected_at": {"type": "string", "minLength": 1},
    "reported_urls": {"type": "array", "items": {"type": "string"}},
    "suspected_sites": {"type": "array", "items": {"type": "string"}},
    "suspected_families": {"type": "array", "items": {"type": "string"}},
    "suspected_platforms": {"type": "array", "items": {"type": "string"}},
    "suspected_locales": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "incident_types": {"type": "array", "items": {"type": "string"}},
    "source_repository": {"type": "string"},
    "source_revision": {"type": "string"},
    "production_revision": {"type": ["string", "null"]},
    "known_bad_changes": {"type": "array", "items": {"type": "string"}},
    "known_good_revision": {"type": ["string", "null"]},
    "live_verification_required": {"type": "boolean"},
    "CDN_verification_required": {"type": "boolean"},
    "human_review_required": {"type": "boolean"},
    "containment_mode": {"type": "string"},
    "execution_mode": {
      "type": "string",
      "enum": [
        "INVESTIGATION_ONLY",
        "CONTAINMENT_ONLY",
        "DRY_RUN",
        "RECTIFICATION_PREVIEW",
        "CONTROLLED_PRODUCTION_REPAIR",
        "MONITORING_ONLY",
        "RESUME"
      ]
    },
    "allowed_paths": {"type": "array", "items": {"type": "string"}},
    "forbidden_paths": {"type": "array", "items": {"type": "string"}},
    "evidence_root": {"type": "string", "minLength": 1},
    "rollback_required": {"type": "boolean"},
    "terminal_closeout_required": {"type": "boolean"}
  },
  "additionalProperties": true
}
