{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TestReport",
  "description": "pytest summary from Mode 7 (verify).",
  "type": "object",
  "required": ["run_id", "generated_at", "passed", "exit_code", "summary"],
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string" },
    "generated_at": { "type": "string" },
    "passed": { "type": "boolean" },
    "exit_code": { "type": "integer" },
    "summary": {
      "type": "object",
      "properties": {
        "total": { "type": "integer" },
        "passed": { "type": "integer" },
        "failed": { "type": "integer" },
        "errors": { "type": "integer" },
        "skipped": { "type": "integer" },
        "duration_seconds": { "type": ["number", "null"] }
      }
    },
    "failed_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "test_id": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "stdout_tail": { "type": ["string", "null"] }
  }
}
