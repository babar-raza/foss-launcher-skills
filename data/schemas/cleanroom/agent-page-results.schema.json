{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentPageResults",
  "description": "Phase B per-page detailed result with timing and sha256.",
  "type": "object",
  "required": ["run_id", "results"],
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["planned_task_id", "target_path", "status"],
        "properties": {
          "planned_task_id": { "type": "string" },
          "target_path": { "type": "string" },
          "status": { "type": "string", "enum": ["COMPLETED", "SKIPPED_WITH_REASON", "FAILED"] },
          "output_sha256": { "type": ["string", "null"] },
          "started_at": { "type": ["string", "null"] },
          "completed_at": { "type": ["string", "null"] },
          "duration_seconds": { "type": ["number", "null"] },
          "agent_notes": { "type": ["string", "null"] },
          "error": { "type": ["string", "null"] }
        }
      }
    }
  }
}
