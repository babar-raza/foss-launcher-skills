{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentExecutionLedger",
  "description": "Phase B per-page agent execution status. Gates Mode 4 (diff).",
  "type": "object",
  "required": ["run_id", "phase_a_complete", "phase_b_complete", "entries"],
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string" },
    "phase_a_complete": { "type": "boolean" },
    "phase_b_complete": { "type": "boolean" },
    "updated_at": { "type": ["string", "null"] },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["planned_task_id", "subdomain", "skill_id", "target_path", "status", "verification_status"],
        "additionalProperties": false,
        "properties": {
          "planned_task_id": { "type": "string" },
          "subdomain": { "type": "string" },
          "skill_id": { "type": "string" },
          "target_path": { "type": "string" },
          "source_site_plan_entry": { "type": ["string", "null"] },
          "status": {
            "type": "string",
            "enum": ["PLANNED", "RUNNING", "COMPLETED", "SKIPPED_WITH_REASON", "FAILED"]
          },
          "started_at": { "type": ["string", "null"] },
          "completed_at": { "type": ["string", "null"] },
          "output_files": {
            "type": "array",
            "items": { "type": "string" }
          },
          "error": { "type": ["string", "null"] },
          "agent_notes": { "type": ["string", "null"] },
          "verification_status": {
            "type": "string",
            "enum": ["VERIFIED", "UNVERIFIED", "SKIPPED"]
          }
        },
        "if": { "properties": { "status": { "const": "COMPLETED" } }, "required": ["status"] },
        "then": { "properties": { "output_files": { "minItems": 1 } } }
      }
    }
  }
}
