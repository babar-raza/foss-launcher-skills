{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ValidatorReport",
  "description": "Output of Mode 7 (verify) — per-file validator results.",
  "type": "object",
  "required": ["run_id", "generated_at", "overall_passed", "validators"],
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string" },
    "generated_at": { "type": "string" },
    "overall_passed": { "type": "boolean" },
    "validators": {
      "type": "object",
      "properties": {
        "validate_frontmatter": {
          "type": "object",
          "properties": {
            "passed": { "type": "boolean" },
            "exit_code": { "type": "integer" },
            "files_checked": { "type": "integer" },
            "failures": { "type": "array", "items": { "type": "string" } }
          }
        },
        "audit": {
          "type": "object",
          "properties": {
            "passed": { "type": "boolean" },
            "exit_code": { "type": "integer" },
            "files_checked": { "type": "integer" },
            "failures": { "type": "array", "items": { "type": "string" } }
          }
        },
        "smoke_test": {
          "type": "object",
          "properties": {
            "passed": { "type": "boolean" },
            "exit_code": { "type": "integer" },
            "failures": { "type": "array", "items": { "type": "string" } }
          }
        },
        "link_validator": {
          "type": "object",
          "properties": {
            "passed": { "type": "boolean" },
            "exit_code": { "type": "integer" },
            "broken_links": { "type": "integer" },
            "failures": { "type": "array", "items": { "type": "string" } }
          }
        },
        "stale_detect": {
          "type": "object",
          "properties": {
            "passed": { "type": "boolean" },
            "exit_code": { "type": "integer" },
            "stale_citations": { "type": "integer" },
            "failures": { "type": "array", "items": { "type": "string" } }
          }
        },
        "scope_check": {
          "type": "object",
          "properties": {
            "passed": { "type": "boolean" },
            "out_of_scope_changes": { "type": "integer" },
            "failures": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
