# .env.example — Environment variables for foss-launcher-skills-gitlab
#
# Copy this file to .env and fill in values before running content-writing skills.
# Required variables are marked [REQUIRED]. Others are optional or have defaults.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your values
#   source .env   # bash/zsh
#   # or set via config.yaml: content_root: /path/to/repo

# ── Content Repository ────────────────────────────────────────────────────────

# [REQUIRED for content-writing skills]
# Absolute path to the content repository root (e.g. the Hugo site repo).
# All content skills write relative to this path.
# Must NOT point to aspose.org/content in non-production environments.
CONTENT_REPO_PATH=/path/to/your/content-repo

# Optional: override the golden corpus directory used by corpus-scan (S-37).
# Defaults to $CONTENT_REPO_PATH/golden if unset.
GOLDEN_DIR=

# ── Knowledge Pipeline ────────────────────────────────────────────────────────

# [REQUIRED for knowledge-update (S-14) and enrich (S-37)]
# Path to the local clone cache directory used by the knowledge pipeline.
# The enrich script reads FOSS repo clones from this directory.
ASPOSE_CLONE_CACHE=/path/to/clone-cache

# [REQUIRED for repo-patrol (S-102) and discover-products (S-39)]
# Base URL of the aspose.org Git server or GitHub org root.
ASPOSE_ORG=https://github.com/aspose-free

# [REQUIRED for discover-products (S-39)]
# GitHub personal access token for scanning repos.
# Needs: repo read, org read scopes.
GITHUB_TOKEN=ghp_your_token_here

# [REQUIRED for local git operations against GitLab (origin remote)]
# GitLab personal/project access token. GHGL-1 naming rule: this variable is
# always named exactly `gitlab_token` (lowercase) -- no other spelling
# (GITLAB_TOKEN, gitlab_pat, GITLAB_PASSWORD) works; see
# docs/adr/ADR-007-github-gitlab-sync.md.
# Needs: write_repository scope, Maintainer role on the GitLab project.
gitlab_token=glpat_your_token_here

# [OPTIONAL for knowledge-enrich (S-61)]
# API key for the professionalization LLM used in knowledge enrichment.
PROFESSIONALIZE_API_KEY=

# ── Translation Backend ───────────────────────────────────────────────────────

# [REQUIRED for translate (S-107) when using LLM backend]
# Translation provider: llm | ollama | m2m (default: llm)
TRANSLATE_PROVIDER=llm

# LLM backend — used when TRANSLATE_PROVIDER=llm
LLM_API_KEY=
LLM_API_BASE_URL=https://api.anthropic.com

# Primary model for translation (e.g. claude-haiku-4-5-20251001)
TRANSLATE_PRIMARY_MODEL=claude-haiku-4-5-20251001

# Ollama backend — used when TRANSLATE_PROVIDER=ollama
TRANSLATE_OLLAMA_BASE_URL=http://localhost:11434
TRANSLATE_OLLAMA_MODEL=mistral

# Translation behavior
# Set to 1 to run translation in offline mode (no API calls; uses cache only)
TRANSLATE_OFFLINE=0

# Per-request timeout in seconds for translation API calls
TRANSLATE_TIMEOUT=60

# Path to the translation cache file (SQLite).
# Defaults to .translation_cache.db in the repo root.
TRANSLATION_CACHE_PATH=

# Comma-separated list of model IDs that are blocked from translation use.
TRANSLATE_MODEL_BLOCKLIST=

# Set to 1 to allow thinking/reasoning models for translation.
TRANSLATE_ALLOW_THINKING_MODELS=0

# ── HuggingFace (M2M backend) ─────────────────────────────────────────────────

# Used when TRANSLATE_PROVIDER=m2m (local HuggingFace M2M-100 model)
HF_HOME=~/.cache/huggingface
HUGGINGFACE_HUB_CACHE=~/.cache/huggingface/hub
