# .env.example — Copy this file to .env and fill in real values.
# The .env file is git-ignored and must never be committed.
# All values shown here are safe placeholder defaults.

# ---------------------------------------------------------------------------
# scripts/pipeline/ — enrich.py, refresh_knowledge.py, update_product_registry.py
# ---------------------------------------------------------------------------

# GitHub personal access token for org scanning (update_product_registry.py)
GITHUB_TOKEN=

# Override path to FOSS repo clone cache (default: runs/.clone_cache/)
ASPOSE_CLONE_CACHE=

# API key for llm.professionalize.com (enrich.py, gap-eval/run.py)
# If unset, scripts fall back to local Ollama (llama3.2).
PROFESSIONALIZE_API_KEY=

# ---------------------------------------------------------------------------
# scripts/translator/ — cli.py / __main__.py
# ---------------------------------------------------------------------------

# Required: LLM API key for translation backend
LLM_API_KEY=

# Optional overrides (defaults match llm.professionalize.com)
LLM_API_BASE_URL=https://llm.professionalize.com/v1
TRANSLATE_PRIMARY_MODEL=gpt-oss
TRANSLATE_BULK_MODEL=gpt-oss-bulk

# Ollama fallback (used when LLM_API_KEY is absent)
TRANSLATE_OLLAMA_BASE_URL=http://localhost:11434
TRANSLATE_OLLAMA_MODEL=llama3.2

# Provider selection policy (preflight + routing)
# auto    — try llm.professionalize.com → Ollama → M2M100 in order (default)
# llm     — force llm.professionalize.com (error if unavailable)
# ollama  — force local Ollama (error if unavailable)
# m2m     — force local M2M100 offline (error if not downloaded)
TRANSLATE_PROVIDER=auto

# Thinking-model policy
# By default, thinking/reasoning models (o1, deepseek-r1, qwq, etc.) are
# blocked for routine translation. Set to 1 to allow them as a last resort.
TRANSLATE_ALLOW_THINKING_MODELS=0

# Additional comma-separated model name blocklist patterns (regex, case-insensitive).
# Example: TRANSLATE_MODEL_BLOCKLIST=my-internal-reasoning-model,unstable-*
TRANSLATE_MODEL_BLOCKLIST=

# ---------------------------------------------------------------------------
# scripts/seo/ — get_keywords.py, review_keywords.py, pipeline/recommend.py
# ---------------------------------------------------------------------------

# Google Generative AI API key
GOOGLE_API_KEY=

# LiteLLM proxy key
LITELLM_KEY=

# ---------------------------------------------------------------------------
# Agent Metrics — scripts/pipeline/commands/ops/metrics_submitter.py
# METRICS-PLAN-001 (see AGENTS.md §15 for metrics obligation)
# ---------------------------------------------------------------------------

# Endpoint for posting validated MetricsRow payloads (Google Apps Script URL).
# Required only for live test posting (Slice 15) and production posting (Slice 16).
# Default mode is dry-run — this variable is NOT required for local development.
# Never commit a real value. Set locally in .env only.
AGENT_METRICS_ENDPOINT=<set locally — never commit>

# Bearer token for the metrics endpoint.
# Required only for live posting. Never commit, print, or expose.
# Set locally in .env only.
AGENT_METRICS_TOKEN=<set locally — never commit>
