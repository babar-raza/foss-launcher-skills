  "hooks": {
    "UserPromptSubmit": [],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/ci/hooks/check_session_gate.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/ci/hooks/check_content_edit_hook.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/ci/hooks/check_skill_context_hook.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/ci/hooks/check_venv_bash_hook.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/ci/hooks/check_destructive_bash_hook.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/ci/hooks/check_write_path_hook.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/ci/hooks/check_py_write_hook.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/ci/hooks/check_content_write_hook.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/ci/hooks/check_skill_context_hook.sh"
          }
        ]
      }
    ]
  }
}
