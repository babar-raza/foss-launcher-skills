{
  "permissions": {
    "allow": [
      "Bash(bash scripts/ci/hooks/bootstrap_session_gate.sh)",
      "Bash(.venv/Scripts/python -m pytest tests/*)",
      "Bash(.venv/Scripts/python -m pytest scripts/pipeline/tests/*)",
      "Bash(.venv/Scripts/python -m pytest scripts/ci/tests/*)",
      "Bash(PYTHONPATH=scripts/pipeline .venv/Scripts/python -m pytest scripts/pipeline/tests/*)",
      "Bash(PYTHONPATH=\"scripts/pipeline\" .venv/Scripts/python -m pytest scripts/pipeline/tests/*)",
      "Bash(.venv/Scripts/python scripts/ci/checks/check_skill_registry_json.py)",
      "Bash(.venv/Scripts/python scripts/pipeline/commands/ops/sync_skills.py --check)",
      "Bash(.venv/Scripts/python scripts/pipeline/commands/ops/post_refresh_verify.py *)",
      "Bash(.venv/Scripts/python scripts/pipeline/commands/diagnostics/repo_patrol.py report)",
      "Bash(PYTHONPATH=scripts/pipeline .venv/Scripts/python scripts/ci/checks/check_python_placement.py --check-staged)",
      "Bash(.venv/Scripts/python scripts/ci/checks/check_skill_readme_coverage.py --fix)",
      "Bash(PYTHONPATH=scripts/pipeline .venv/Scripts/python scripts/pipeline/commands/governance/skill_context.py *)",
      "Bash(.venv/Scripts/python scripts/ci/checks/enforce_venv_python.py --check)"
    ],
    "additionalDirectories": [
      "d:\\onedrive\\Documents\\GitHub\\aspose.org\\plans\\healing",
      "D:\\onedrive\\Documents\\GitHub\\aspose.org\\plans\\healing"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/ci/hooks/check_session_gate.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/ci/hooks/check_content_edit_hook.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/ci/hooks/check_skill_context_hook.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/ci/hooks/check_venv_bash_hook.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/ci/hooks/check_destructive_bash_hook.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/ci/hooks/check_write_path_hook.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/ci/hooks/check_py_write_hook.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/ci/hooks/check_content_write_hook.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/ci/hooks/check_skill_context_hook.sh"
          }
        ]
      }
    ]
  }
}
