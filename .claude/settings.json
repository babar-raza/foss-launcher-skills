{
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python -m pytest tests/test_runner_reference_injection.py -v)",
      "Bash(python scripts/pipeline/sync_skills.py --check)",
      "Bash(echo \"EXIT:$?\")",
      "Bash(PYTHONPATH=\"scripts/pipeline;C:/Users/prora/AppData/Roaming/Python/Python313/site-packages\" python -c \"import sys; sys.path.insert\\(0, ''C:/Users/prora/AppData/Roaming/Python/Python313/site-packages''\\); import pytest; sys.exit\\(pytest.main\\([''scripts/pipeline/tests/'', ''-q'', ''--tb=line'', ''--ignore=scripts/pipeline/tests/test_sync_skills.py'']\\)\\)\")",
      "Bash(.venv/Scripts/python -m pytest scripts/pipeline/tests/test_check_onboarding_integrity.py -v --tb=short)",
      "Bash(.venv/Scripts/python -m pytest scripts/pipeline/tests/ -q)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'rm -f .claude/.agents_read && echo \"[hook] Session gate reset — run /session-start before any task\"'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'if [ ! -f .claude/.agents_read ]; then echo \"⛔ AGENTS.md not confirmed read. Session gate: run /session-start before proceeding.\"; exit 1; fi'"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/ci/check_content_edit_hook.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/ci/check_py_write_hook.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/ci/check_content_write_hook.sh"
          }
        ]
      }
    ]
  }
}
