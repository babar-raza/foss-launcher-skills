{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision Report",
  "description": "Per-page action decisions: create, update, enhance, verify_only, or no_change.",
  "type": "object",
  "required": ["schema_version", "family", "platform", "decided_at", "pages", "summary"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "family": { "type": "string" },
    "platform": { "type": "string" },
    "decided_at": { "type": "string" },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["site_type", "slug", "action", "reason", "priority"],
        "properties": {
          "site_type": { "type": "string" },
          "slug": { "type": "string" },
          "path": { "type": ["string", "null"] },
          "action": {
            "type": "string",
            "enum": ["create", "update", "enhance", "verify_only", "no_change"]
          },
          "reason": { "type": "string" },
          "priority": { "type": "integer", "minimum": 1 },
          "affected_by_diff": { "type": "boolean" },
          "verification_result": { "type": ["string", "null"] },
          "sections_to_update": {
            "type": ["array", "null"],
            "items": { "type": "string" }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["create", "update", "enhance", "verify_only", "no_change", "total"],
      "properties": {
        "create": { "type": "integer", "minimum": 0 },
        "update": { "type": "integer", "minimum": 0 },
        "enhance": { "type": "integer", "minimum": 0 },
        "verify_only": { "type": "integer", "minimum": 0 },
        "no_change": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
