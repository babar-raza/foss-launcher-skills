{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product Evidence File (PEF)",
  "description": "Canonical aggregation of all knowledge artifacts for a family/platform product.",
  "type": "object",
  "required": [
    "schema_version", "family", "platform", "display_name",
    "materialized_at", "source_sha", "provenance_summary",
    "api_confidence", "claims", "api_surface", "formats"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "family": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string" },
    "materialized_at": { "type": "string", "format": "date-time" },
    "source_sha": { "type": "string" },
    "provenance_summary": {
      "type": "object",
      "required": ["dual", "dual_fuzzy", "scout_only", "external_only", "total", "dual_pct"],
      "properties": {
        "dual": { "type": "integer", "minimum": 0 },
        "dual_fuzzy": { "type": "integer", "minimum": 0 },
        "scout_only": { "type": "integer", "minimum": 0 },
        "external_only": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "dual_pct": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "api_confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "text"],
        "properties": {
          "claim_id": { "type": "string" },
          "kind": { "type": "string" },
          "text": { "type": "string" },
          "confidence": { "type": "number" },
          "provenance": { "type": "string" },
          "evidence": { "type": "array" }
        }
      }
    },
    "api_surface": {
      "type": "array",
      "items": { "type": "object" }
    },
    "formats": {
      "type": "array",
      "items": { "type": "object" }
    },
    "class_graph": { "type": ["array", "object"] },
    "coverage_matrix": { "type": ["array", "object"] },
    "constants": { "type": "array" },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "install": {
      "type": "object",
      "properties": {
        "command": { "type": "string" },
        "version": { "type": "string" },
        "raw_md": { "type": "string" }
      }
    },
    "snippets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "filename": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    },
    "forbidden_claims": { "type": "array", "items": { "type": "string" } },
    "index_metadata": { "type": "object" }
  }
}
