# Operator documentation — always LF (prevents CRLF noise on Windows Git)
RUNBOOK.md          text eol=lf
OPERATOR_GUIDE.md   text eol=lf
docs/QUICKSTART.md  text eol=lf
AGENTS.md           text eol=lf
CLAUDE.md           text eol=lf

# SEO keyword data — machine-generated by CI; normalize to LF to prevent merge noise
keywords/*.json     text eol=lf
# Shell scripts — must use LF to run correctly on all platforms
*.sh            text eol=lf

# Content pages — always LF; prevents Windows core.autocrlf CRLF drift that
# collapses GitHub Desktop's diff view into a false "no content changes"
content/**      text eol=lf
